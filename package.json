{
  "name": "vue-forge",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-forge.umd.cjs",
  "module": "./dist/vue-forge.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-forge.es.js",
      "require": "./dist/vue-forge.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite --config src/examples/vite.config.ts",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:playground": "vite build --config src/examples/vite.config.ts"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.0.0",
    "sass": "^1.106.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.4.0",
    "vue-tsc": "^2.2.12"
  }
}
